generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Counter {
  id    String @id
  value Int    @default(0)
}

enum Role {
  OWNER
  ADMIN
  USER
}

enum Category {
  PET_ACCESSORIES
  PET_CARE
  PET_FOOD
  PET_MEDICINE
  PET_DRESS
  PET_TOY
  PET_LITTER
}

enum AttributeType {
  COLOR
  SIZE
  WEIGHT
}

enum StockEventType {
  INITIAL
  PURCHASE
  RETURN
  RESTOCK
  DAMAGE
  EXPIRED
  LOSS
  ADJUSTMENT
  INCREASE
  DECREASE
}

enum DiscountType {
  FIXED
  PERCENTAGE
  FREE_DELIVERY
}

enum PaymentMethod {
  COD
  BKASH
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
  MANUAL
}

enum CourierStatus {
  IN_REVIEW
  PENDING
  DELIVERED_APPROVAL_PENDING
  PARTIAL_DELIVERED_APPROVAL_PENDING
  CANCELLED_APPROVAL_PENDING
  UNKNOWN_APPROVAL_PENDING
  DELIVERED
  PARTIAL_DELIVERED
  CANCELLED
  HOLD
  UNKNOWN
}

enum OrderStatus {
  IN_REVIEW
  PENDING
  DELIVERY_APPROVAL_PENDING
  PARTIAL_DELIVERY_APPROVAL_PENDING
  CANCELLED_APPROVAL_PENDING
  UNKNOWN_APPROVAL_PENDING
  RETURNED_PARTIAL
  DELIVERED
  PARTIAL_DELIVERED
  CANCELLED
  HOLD
  UNKNOWN
  RETURNED
}

enum OrderType {
  WEB
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportChannel {
  WEB_TICKET
  WHATSAPP
  MESSENGER
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum SmsCampaignType {
  MANUAL_BROADCAST
  TARGETED_SEGMENT
  AUTOMATED_TRIGGER
  PROMOTIONAL_FLASH
  CART_RECOVERY
}

enum SmsCampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SmsDeliveryStatus {
  PENDING
  SUBMITTED
  DELIVERED
  FAILED
}

enum SmsTemplateCategory {
  ORDER_UPDATE
  PROMOTIONAL
  OTP
  SEASONAL
  CART_RECOVERY
  WELCOME
  CUSTOM
}

enum EmailCampaignType {
  MANUAL_BROADCAST
  TARGETED_SEGMENT
  AUTOMATED_TRIGGER
  PROMOTIONAL_FLASH
  CART_RECOVERY
  NEWSLETTER_DIGEST
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum EmailTemplateCategory {
  ORDER_RECEIPT
  ORDER_STATUS
  PROMOTIONAL
  WELCOME_SERIES
  ABANDONED_CART
  NEWSLETTER
  PET_CARE_TIPS
  CUSTOM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  STOCK_CHANGE
  PRICE_CHANGE
  ROLE_CHANGE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  EXPORT
  PAYMENT_RECEIVED
  COURIER_DISPATCH
  REFUND
  SETTINGS_UPDATE
  BROADCAST_SENT
  OTHER
}

enum AuditEntity {
  ORDER
  PRODUCT
  VARIANT
  COMBO_PRODUCT
  STOCK
  CATEGORY
  BRAND
  COUPON
  CAMPAIGN
  USER
  CUSTOMER
  SUPPORT_TICKET
  SMS
  EMAIL
  NEWSLETTER
  PAYMENT
  SHIPMENT
  SYSTEM_SETTINGS
  AUTH
  OTHER
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
  SECURITY
}

model User {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  code     String  @unique
  name     String
  email    String  @unique
  googleId String? @unique
  otpHash  String? @unique
  avatar   String?
  phone    String?
  district String?
  address  String?
  role     Role    @default(USER)

  // Forgin Keys

  // Parent Relations

  // Child Relations
  sessions       Session[]
  coupons        Coupon[]
  wishlist       Wishlist?
  cart           Cart?
  orders         Order[]
  payments       Payment[]
  supportTickets SupportTicket[]
  smsLogs        SmsLog[]
  emailLogs      EmailLog[]
  auditLogs      AuditLog[]

  // Timestamps
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Indexes and Constraints
}

model Session {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  tokenHash String @unique

  // Forgin Keys
  userId String

  // Parent Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model SubCategory {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name     String
  slug     String   @unique
  image    String
  category Category

  // Forign Keys

  // Parent Relations

  // Child Relations
  products  Product[]
  coupons   Coupon[]
  campaigns Campaign[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Brand {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name  String
  slug  String @unique
  image String

  // Forign Keys

  // Parent Relations

  // Child Relations
  products  Product[]
  coupons   Coupon[]
  campaigns Campaign[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Slider {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  image      String
  text       String
  buttonText String
  buttonLink String

  // Forign Keys

  // Parent Relations

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Product {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name             String
  code             String   @unique
  slug             String   @unique
  sku              String   @unique
  shortDescription String
  longDescription  String
  image            String
  gallery          String[]
  isVariable       Boolean
  costPrice        String?
  regularPrice     String?
  salePrice        String?
  stock            Int?

  // Forign Keys
  subCategoryId String
  brandId       String?

  // Parent Relations
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  brand       Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Child Relations
  variants      Variant[]
  stockEvents   StockEvent[]
  comboProducts ComboProduct[]
  coupons       Coupon[]
  campaign      Campaign[]
  wishlists     Wishlist[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Variant {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  sku          String @unique
  image        String
  costPrice    String
  regularPrice String
  salePrice    String
  stock        Int

  // Forign Keys
  productId String

  // Parent Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Child Relations
  attributes    Attribute[]
  stockEvents   StockEvent[]
  comboProducts ComboProduct[]
  coupons       Coupon[]
  campaign      Campaign[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Attribute {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  type  AttributeType
  name  String
  value String

  // Forign Keys
  variantId String

  // Parent Relations
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model StockEvent {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  type          StockEventType @default(INITIAL)
  quantity      Int            @default(0)
  previousStock Int?           @default(0)
  newStock      Int?           @default(0)
  reason        String?
  note          String?

  // Forign Keys
  productId String?
  variantId String?

  // Parent Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model ComboProduct {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name             String
  code             String   @unique
  slug             String   @unique
  sku              String   @unique
  shortDescription String
  longDescription  String
  image            String
  gallery          String[]
  regularPrice     String?
  salePrice        String?

  // Forign Keys

  // Parent Relations

  // Child Relations
  products   Product[]
  variants   Variant[]
  coupons    Coupon[]
  campaign   Campaign[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Coupon {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name                String
  couponCode          String       @unique
  discount            String?
  discountType        DiscountType
  minOrder            String?
  maxOrder            String?
  maxRedemptions      Int?
  minPurchaseAmount   String?
  currentRedemptions  Int          @default(0)
  forAllUsers         Boolean      @default(false)
  forAllCategories    Boolean      @default(false)
  forAllSubCategories Boolean      @default(false)
  forAllBrands        Boolean      @default(false)
  forAllProducts      Boolean      @default(false)
  forAllCombos        Boolean      @default(false)

  // Forign Keys

  // Parent Relations
  users         User[]
  categories    Category[]
  subCategories SubCategory[]
  brands        Brand[]
  products      Product[]
  variants      Variant[]
  comboProducts ComboProduct[]

  // Child Relations

  // Timestamps
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Campaign {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name                String
  description         String
  banner              String
  discount            String?
  discountType        DiscountType
  minPurchaseAmount   String?
  maxRedemptions      Int?
  currentRedemptions  Int          @default(0)
  forAllCategories    Boolean      @default(false)
  forAllSubCategories Boolean      @default(false)
  forAllBrands        Boolean      @default(false)
  forAllProducts      Boolean      @default(false)
  forAllCombos        Boolean      @default(false)

  // Forign Keys

  // Parent Relations

  // Child Relations
  categories    Category[]
  subCategories SubCategory[]
  brands        Brand[]
  products      Product[]
  variants      Variant[]
  comboProducts ComboProduct[]

  // Timestamps
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Wishlist {
  // Primary Key
  id String @id @default(cuid())

  // Fields

  // Forign Keys
  userId String @unique

  // Parent Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations
  products Product[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Cart {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  isTemporary Boolean

  // Forign Keys
  userId String? @unique

  // Parent Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations
  cartItems CartItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model CartItem {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  quanitity Int @default(1)

  // Forign Keys
  cartId         String
  productId      String?
  variantId      String?
  comboProductId String?

  // Parent Relations
  cart         Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      Variant?      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  comboProduct ComboProduct? @relation(fields: [comboProductId], references: [id], onDelete: Cascade)

  // Child Relations  

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Order {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  code          String        @unique
  totalQuantity Int
  totalCost     String
  totalPrice    String
  discountCost  String
  finalCost     String
  name          String
  email         String
  phone         String
  address       String
  district      String
  note          String?
  status        OrderStatus
  type          OrderType
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus

  // Forign Keys
  userId String?

  // Parent Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations
  orderItems     OrderItem[]
  payment        Payment?
  shipment       Shipment?
  supportTickets SupportTicket[]
  smsLogs        SmsLog[]
  emailLogs      EmailLog[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model OrderItem {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  quanitity    Int
  totalCost    String
  unitPrice    String
  discountCost String
  finalCost    String
  status       OrderStatus

  // Forign Keys
  orderId        String
  productId      String?
  variantId      String?
  comboProductId String?

  // Parent Relations
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      Variant?      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  comboProduct ComboProduct? @relation(fields: [comboProductId], references: [id], onDelete: Cascade)

  // Child Relations  

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model SupportTicket {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  code     String                @unique
  subject  String
  message  String
  category String
  status   SupportTicketStatus   @default(OPEN)
  priority SupportTicketPriority @default(MEDIUM)
  channel  SupportChannel        @default(WEB_TICKET)

  // Forign Keys
  userId  String
  orderId String?

  // Parent Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model NewsletterSubscriber {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  email     String           @unique
  status    NewsletterStatus @default(SUBSCRIBED)
  source    String?          @default("FOOTER") // FOOTER, POPUP, CHECKOUT, MANUAL
  ipAddress String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  amount                  String
  currency                String        @default("BDT")
  paymentMethod           PaymentMethod @default(BKASH)
  status                  PaymentStatus @default(PENDING)
  paymentID               String?       @unique
  trxID                   String?       @unique
  customerMsisdn          String?
  payerReference          String?
  merchantInvoiceNumber   String?
  transactionStatus       String?
  intent                  String?
  statusCode              String?
  statusMessage           String?
  paymentCreateTime       String?
  paymentExecuteTime      String?
  refundTrxId             String?
  refundTransactionStatus String?
  refundAmount            String?
  refundTime              String?
  refundReason            String?
  rawResponse             Json?

  // Forign Keys
  orderId String  @unique
  userId  String?

  // Parent Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
  @@index([trxID])
  @@index([paymentID])
}

model Shipment {
  // Primary Key
  id String @id @default(cuid())

  // Courier Provider & Core IDs
  provider         CourierProvider @default(STEADFAST)
  consignmentId    Int?            @unique
  trackingCode     String?         @unique
  invoice          String

  // Consignment Details
  recipientName    String
  recipientPhone   String
  alternativePhone String?
  recipientEmail   String?
  recipientAddress String
  codAmount        String
  deliveryType     Int?            @default(0) // 0: Home Delivery, 1: Point/Hub Pick Up
  note             String?
  itemDescription  String?
  totalLot         Int?            @default(1)

  // Status & Tracking
  status           CourierStatus   @default(IN_REVIEW)
  rawStatus        String?
  rawResponse      Json?
  lastCheckedAt    DateTime?

  // Relations
  orderId          String          @unique
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Indexes
  @@index([trackingCode])
  @@index([consignmentId])
  @@index([invoice])
}

model SmsCampaign {
  // Primary Key
  id              String            @id @default(cuid())

  // Fields
  title           String
  type            SmsCampaignType   @default(TARGETED_SEGMENT)
  status          SmsCampaignStatus @default(DRAFT)
  message         String
  senderId        String?
  targetSegment   String?
  segmentFilters  Json?
  totalRecipients Int               @default(0)
  sentCount       Int               @default(0)
  failedCount     Int               @default(0)
  estimatedCost   String?
  actualCost      String?
  scheduledAt     DateTime?
  completedAt     DateTime?

  // Relations
  logs            SmsLog[]

  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([type])
}

model SmsLog {
  // Primary Key
  id             String            @id @default(cuid())

  // Fields
  recipientPhone String
  recipientName  String?
  message        String
  status         SmsDeliveryStatus @default(PENDING)
  responseCode   Int?
  statusMessage  String?
  rawResponse    Json?

  // Foreign Keys & Relations
  campaignId     String?
  campaign       SmsCampaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([recipientPhone])
  @@index([status])
  @@index([campaignId])
}

model SmsTemplate {
  // Primary Key
  id          String              @id @default(cuid())

  // Fields
  title       String
  category    SmsTemplateCategory @default(PROMOTIONAL)
  body        String
  variables   String[]
  isDefault   Boolean             @default(false)

  // Timestamps
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([category])
}

model SmsAutomationSettings {
  // Primary Key
  id                      String   @id @default("default")

  // Automated Event Toggles
  orderPlacedSms          Boolean  @default(true)
  orderDispatchedSms      Boolean  @default(true)
  orderDeliveredSms       Boolean  @default(true)
  bkashPaymentPaidSms     Boolean  @default(true)

  // Custom Message Templates
  orderPlacedTemplate     String?
  orderDispatchedTemplate String?
  orderDeliveredTemplate  String?
  bkashPaidTemplate       String?

  // Timestamps
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model EmailCampaign {
  // Primary Key
  id              String              @id @default(cuid())

  // Fields
  title           String
  subject         String
  previewText     String?
  contentHtml     String
  contentText     String?
  type            EmailCampaignType   @default(PROMOTIONAL_FLASH)
  status          EmailCampaignStatus @default(DRAFT)
  targetSegment   String              @default("ALL_CUSTOMERS")
  segmentFilters  Json?
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  scheduledAt     DateTime?
  completedAt     DateTime?

  // Relations
  logs            EmailLog[]

  // Timestamps
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([type])
}

model EmailLog {
  // Primary Key
  id             String              @id @default(cuid())

  // Fields
  recipientEmail String
  recipientName  String?
  subject        String
  status         EmailDeliveryStatus @default(PENDING)
  messageId      String?
  errorMessage   String?

  // Foreign Keys & Relations
  campaignId     String?
  campaign       EmailCampaign?      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([recipientEmail])
  @@index([status])
  @@index([campaignId])
}

model EmailTemplate {
  // Primary Key
  id          String                @id @default(cuid())

  // Fields
  title       String
  subject     String
  previewText String?
  category    EmailTemplateCategory @default(PROMOTIONAL)
  htmlContent String
  textContent String?
  variables   String[]
  isDefault   Boolean               @default(false)

  // Timestamps
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([category])
}

model EmailAutomationSettings {
  // Primary Key
  id                        String   @id @default("default")

  // Automated Event Toggles
  orderPlacedEmail          Boolean  @default(true)
  orderDispatchedEmail      Boolean  @default(true)
  orderDeliveredEmail       Boolean  @default(true)
  bkashPaymentPaidEmail     Boolean  @default(true)
  welcomeNewUserEmail       Boolean  @default(true)
  abandonedCartEmail        Boolean  @default(false)

  // Custom Subject Lines
  orderPlacedSubject        String?
  orderDispatchedSubject    String?
  orderDeliveredSubject     String?
  bkashPaidSubject          String?
  welcomeUserSubject        String?

  // Timestamps
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model AuditLog {
  // Primary Key
  id String @id @default(cuid())

  // Core Audit Attributes
  action     AuditAction
  entity     AuditEntity
  entityId   String?
  entityName String?
  summary    String
  severity   AuditSeverity @default(INFO)

  // Detailed State Tracking (Diff & Metadata)
  previousState Json?
  newState      Json?
  metadata      Json?

  // Origin & Network Context
  ipAddress String?
  userAgent String?
  path      String?

  // Foreign Keys & Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes for high-performance audit query & filtering
  @@index([entity, entityId])
  @@index([action])
  @@index([userId])
  @@index([severity])
  @@index([createdAt])
}
