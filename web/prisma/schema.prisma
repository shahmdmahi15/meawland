generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Counter {
  id    String @id
  value Int    @default(0)
}

enum Role {
  OWNER
  ADMIN
  USER
}

enum Category {
  PET_ACCESSORIES
  PET_CARE
  PET_FOOD
  PET_MEDICINE
  PET_DRESS
  PET_TOY
  PET_LITTER
}

enum AttributeType {
  COLOR
  SIZE
  WEIGHT
}

model User {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  code     String  @unique
  name     String
  email    String  @unique
  googleId String? @unique
  otpHash  String? @unique
  avatar   String?
  phone    String?
  district String?
  address  String?
  role     Role    @default(USER)

  // Forgin Keys

  // Parent Relations

  // Child Relations
  sessions Session[]

  // Timestamps
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Indexes and Constraints
}

model Session {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  tokenHash String @unique

  // Forgin Keys
  userId String

  // Parent Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model SubCategory {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name     String
  slug     String   @unique
  image    String
  category Category

  // Forign Keys

  // Parent Relations

  // Child Relations
  products Product[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Brand {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name  String
  slug  String @unique
  image String

  // Forign Keys

  // Parent Relations

  // Child Relations
  products Product[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Slider {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  image      String
  text       String
  buttonText String
  buttonLink String

  // Forign Keys

  // Parent Relations

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Product {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name             String
  code             String   @unique
  slug             String   @unique
  sku              String   @unique
  shortDescription String
  longDescription  String
  image            String
  gallery          String[]
  isVariable       Boolean
  costPrice        String?
  regularPrice     String?
  salePrice        String?
  stock            Int?

  // Forign Keys
  subCategoryId String
  brandId       String?

  // Parent Relations
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  brand       Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Child Relations
  variants    Variant[]
  stockEvents StockEvent[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Variant {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  sku          String @unique
  image        String
  costPrice    String
  regularPrice String
  salePrice    String
  stock        Int

  // Forign Keys
  productId String

  // Parent Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Child Relations
  attributes  Attribute[]
  stockEvents StockEvent[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Attribute {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  type  AttributeType
  name  String
  value String

  // Forign Keys
  variantId String

  // Parent Relations
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model StockEvent {
  // Primary Key
  id String @id @default(cuid())

  // Fields

  // Forign Keys
  productId String?
  variantId String?

  // Parent Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}
