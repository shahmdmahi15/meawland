generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Counter {
  id    String @id
  value Int    @default(0)
}

enum Role {
  OWNER
  ADMIN
  USER
}

enum Category {
  PET_ACCESSORIES
  PET_CARE
  PET_FOOD
  PET_MEDICINE
  PET_DRESS
  PET_TOY
  PET_LITTER
}

enum AttributeType {
  COLOR
  SIZE
  WEIGHT
}

enum StockEventType {
  INITIAL
  PURCHASE
  RETURN
  RESTOCK
  DAMAGE
  EXPIRED
  LOSS
  ADJUSTMENT
  INCREASE
  DECREASE
}

enum DiscountType {
  FIXED
  PERCENTAGE
  FREE_DELIVERY
}

enum PaymentMethod {
  COD
  BKASH
}

enum OrderStatus {
  IN_REVIEW
  PENDING
  DELIVERY_APPROVAL_PENDING
  PARTIAL_DELIVERY_APPROVAL_PENDING
  CANCELLED_APPROVAL_PENDING
  UNKNOWN_APPROVAL_PENDING
  RETURNED_PARTIAL
  DELIVERED
  PARTIAL_DELIVERED
  CANCELLED
  HOLD
  UNKNOWN
  RETURNED
}

enum OrderType {
  WEB
  OTHER
}

model User {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  code     String  @unique
  name     String
  email    String  @unique
  googleId String? @unique
  otpHash  String? @unique
  avatar   String?
  phone    String?
  district String?
  address  String?
  role     Role    @default(USER)

  // Forgin Keys

  // Parent Relations

  // Child Relations
  sessions Session[]
  coupons  Coupon[]
  wishlist Wishlist?
  cart     Cart?
  orders   Order[]

  // Timestamps
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Indexes and Constraints
}

model Session {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  tokenHash String @unique

  // Forgin Keys
  userId String

  // Parent Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model SubCategory {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name     String
  slug     String   @unique
  image    String
  category Category

  // Forign Keys

  // Parent Relations

  // Child Relations
  products  Product[]
  coupons   Coupon[]
  campaigns Campaign[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Brand {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name  String
  slug  String @unique
  image String

  // Forign Keys

  // Parent Relations

  // Child Relations
  products  Product[]
  coupons   Coupon[]
  campaigns Campaign[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Slider {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  image      String
  text       String
  buttonText String
  buttonLink String

  // Forign Keys

  // Parent Relations

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Product {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name             String
  code             String   @unique
  slug             String   @unique
  sku              String   @unique
  shortDescription String
  longDescription  String
  image            String
  gallery          String[]
  isVariable       Boolean
  costPrice        String?
  regularPrice     String?
  salePrice        String?
  stock            Int?

  // Forign Keys
  subCategoryId String
  brandId       String?

  // Parent Relations
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  brand       Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Child Relations
  variants      Variant[]
  stockEvents   StockEvent[]
  comboProducts ComboProduct[]
  coupons       Coupon[]
  campaign      Campaign[]
  wishlists     Wishlist[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Variant {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  sku          String @unique
  image        String
  costPrice    String
  regularPrice String
  salePrice    String
  stock        Int

  // Forign Keys
  productId String

  // Parent Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Child Relations
  attributes    Attribute[]
  stockEvents   StockEvent[]
  comboProducts ComboProduct[]
  coupons       Coupon[]
  campaign      Campaign[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Attribute {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  type  AttributeType
  name  String
  value String

  // Forign Keys
  variantId String

  // Parent Relations
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model StockEvent {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  type          StockEventType @default(INITIAL)
  quantity      Int            @default(0)
  previousStock Int?           @default(0)
  newStock      Int?           @default(0)
  reason        String?
  note          String?

  // Forign Keys
  productId String?
  variantId String?

  // Parent Relations
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Child Relations

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model ComboProduct {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name             String
  code             String   @unique
  slug             String   @unique
  sku              String   @unique
  shortDescription String
  longDescription  String
  image            String
  gallery          String[]
  regularPrice     String?
  salePrice        String?

  // Forign Keys

  // Parent Relations

  // Child Relations
  products   Product[]
  variants   Variant[]
  coupons    Coupon[]
  campaign   Campaign[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Coupon {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name                String
  couponCode          String       @unique
  discount            String?
  discountType        DiscountType
  minOrder            String?
  maxOrder            String?
  maxRedemptions      Int?
  minPurchaseAmount   String?
  currentRedemptions  Int          @default(0)
  forAllUsers         Boolean      @default(false)
  forAllCategories    Boolean      @default(false)
  forAllSubCategories Boolean      @default(false)
  forAllBrands        Boolean      @default(false)
  forAllProducts      Boolean      @default(false)
  forAllCombos        Boolean      @default(false)

  // Forign Keys

  // Parent Relations
  users         User[]
  categories    Category[]
  subCategories SubCategory[]
  brands        Brand[]
  products      Product[]
  variants      Variant[]
  comboProducts ComboProduct[]

  // Child Relations

  // Timestamps
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Campaign {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  name                String
  description         String
  banner              String
  discount            String?
  discountType        DiscountType
  minPurchaseAmount   String?
  maxRedemptions      Int?
  currentRedemptions  Int          @default(0)
  forAllCategories    Boolean      @default(false)
  forAllSubCategories Boolean      @default(false)
  forAllBrands        Boolean      @default(false)
  forAllProducts      Boolean      @default(false)
  forAllCombos        Boolean      @default(false)

  // Forign Keys

  // Parent Relations

  // Child Relations
  categories    Category[]
  subCategories SubCategory[]
  brands        Brand[]
  products      Product[]
  variants      Variant[]
  comboProducts ComboProduct[]

  // Timestamps
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Wishlist {
  // Primary Key
  id String @id @default(cuid())

  // Fields

  // Forign Keys
  userId String @unique

  // Parent Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations
  products Product[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Cart {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  isTemporary Boolean

  // Forign Keys
  userId String? @unique

  // Parent Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations
  cartItems CartItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model CartItem {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  quanitity Int @default(1)

  // Forign Keys
  cartId         String
  productId      String?
  variantId      String?
  comboProductId String?

  // Parent Relations
  cart         Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      Variant?      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  comboProduct ComboProduct? @relation(fields: [comboProductId], references: [id], onDelete: Cascade)

  // Child Relations  

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model Order {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  code          String        @unique
  totalQuantity Int
  totalCost     String
  totalPrice    String
  discountCost  String
  finalCost     String
  name          String
  email         String
  phone         String
  address       String
  district      String
  note          String?
  paymentMethod PaymentMethod
  status        OrderStatus
  type OrderType

  // Forign Keys
  userId String?

  // Parent Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Child Relations
  orderItems OrderItem[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}

model OrderItem {
  // Primary Key
  id String @id @default(cuid())

  // Fields
  quanitity    Int
  totalCost    String
  unitPrice    String
  discountCost String
  finalCost    String
  status       OrderStatus

  // Forign Keys
  orderId        String
  productId      String?
  variantId      String?
  comboProductId String?

  // Parent Relations
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      Variant?      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  comboProduct ComboProduct? @relation(fields: [comboProductId], references: [id], onDelete: Cascade)

  // Child Relations  

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes and Constraints
}
